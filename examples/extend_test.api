typedef struct {
    id int
    code string [[仓库编码]]
    name string [[仓库名字]]
    summary? string [[备注]]
    order_no int [[排序]]
    status EnumStandardStatus
    created_time string
    updated_time string
    ss_customer_info SelectInfo [[所属客户id]]
    stock_info SelectInfo [[所在仓库]]
} StockShelfLocationListData

typedef struct extend SelectInfo {
  stock_info SelectInfo [[所在仓库]]
} StockShelfLocationSelectInfo
